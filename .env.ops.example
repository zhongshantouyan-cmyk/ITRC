# Set the following section in the BACKEND deployment environment.
# Never commit populated copies. Match backend/frontend branches and environments.
# Existing FIREBASE_SERVICE_ACCOUNT and TURSO_DATABASE_URL/TURSO_AUTH_TOKEN are reused.
# First server startup may create/migrate tables, even during an HTTP health check.

# Explicit identities. Empty lists disable final approval / marketing approval.
OPS_APPROVER_EMAILS=
OPS_DESIGNER_EMAILS=

# Safe default: rule drafts. Enable AI only after choosing the account/model/budget.
OPENAI_API_KEY=
OPENAI_MODEL=
OPS_PROVIDER_TIMEOUT_MS=20000

# Canva developer integration: exact BACKEND callback URI, plus one template source.
# /api/ops/connections/canva/callback is NOT forwarded by the frontend gateway.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_TEMPLATE_DESIGN_ID=
# CANVA_BRAND_TEMPLATE_ID=  # Alternative to CANVA_TEMPLATE_DESIGN_ID, not both.
CANVA_FIELD_MAP_JSON=
OPS_TOKEN_ENCRYPTION_KEY=
# Return to the paired frontend origin; OAuth callback needs separate live validation.
OPS_FRONTEND_ORIGIN=

# Optional read-only Sheets import. No source is read unless it is allowlisted.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
OPS_SHEET_SOURCES_JSON=[]

# After durable approval, immediately attempt its single job within the request.
OPS_AUTO_RUN_JOBS=false

# A scheduler may invoke /api/ops/jobs/tick using this dedicated bearer secret.
# Use 32-512 random non-whitespace characters; no secret means endpoint disabled.
# The frontend gateway does not proxy this endpoint.
OPS_CRON_SECRET=

# Enable ONLY on an always-running Node host; serverless intervals are not durable.
# Enabling this can automatically run existing jobs after process startup.
OPS_WORKER_ENABLED=false
OPS_WORKER_INTERVAL_SECONDS=60

# FRONTEND project only: workbench-specific public build setting.
# Use /api only when the same-origin gateway is deployed; rebuild after changes.
# If unset, the workbench falls back to the existing VITE_API_URL.
# Keep the existing CMS VITE_API_URL unchanged.
VITE_OPS_API_URL=/api

# FRONTEND SERVER FUNCTION only; never prefix this setting with VITE_.
# Fixed HTTPS *.vercel.app origin, no /api path, query, credentials or custom port.
# Example: https://backend-preview.vercel.app
OPS_BACKEND_ORIGIN=
# @vercel/oidc obtains short-lived tokens server-side; never paste one into this file.
# The caller needs Secure Backend Access with OIDC Federation enabled.
# Backend Trusted Sources must allow the paired project/environment.
# Preview -> Preview authorization does not authorize Production.
