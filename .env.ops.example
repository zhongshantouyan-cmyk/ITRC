# Set these in the backend deployment environment. Never commit populated copies.
# Existing FIREBASE_SERVICE_ACCOUNT and TURSO_DATABASE_URL/TURSO_AUTH_TOKEN are reused.

# Explicit identities. Empty lists disable final approval / marketing approval.
OPS_APPROVER_EMAILS=
OPS_DESIGNER_EMAILS=

# Safe default: rule drafts. Enable AI only after choosing the account/model/budget.
OPENAI_API_KEY=
OPENAI_MODEL=
OPS_PROVIDER_TIMEOUT_MS=20000

# Canva developer integration: exact registered callback URI, plus one template source.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_TEMPLATE_DESIGN_ID=
# CANVA_BRAND_TEMPLATE_ID=  # Alternative to CANVA_TEMPLATE_DESIGN_ID, not both.
CANVA_FIELD_MAP_JSON=
OPS_TOKEN_ENCRYPTION_KEY=
OPS_FRONTEND_ORIGIN=

# Optional read-only Sheets import. No source is read unless it is allowlisted.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
OPS_SHEET_SOURCES_JSON=[]

# After durable approval, immediately attempt its single job within the request.
OPS_AUTO_RUN_JOBS=false

# A scheduler may invoke /api/ops/jobs/tick using this dedicated bearer secret.
# Use 32-512 random non-whitespace characters; no secret means endpoint disabled.
OPS_CRON_SECRET=

# Enable ONLY on an always-running Node host; serverless intervals are not durable.
OPS_WORKER_ENABLED=false
OPS_WORKER_INTERVAL_SECONDS=60
